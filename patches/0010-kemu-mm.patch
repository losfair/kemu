diff --git a/mm/mmap.c b/mm/mmap.c
index 5fd3b80fd..7039b0832 100644
--- a/mm/mmap.c
+++ b/mm/mmap.c
@@ -16,6 +16,7 @@
 #include <linux/mm_inline.h>
 #include <linux/shm.h>
 #include <linux/mman.h>
+#include <linux/kemu.h>
 #include <linux/pagemap.h>
 #include <linux/swap.h>
 #include <linux/syscalls.h>
@@ -88,6 +89,18 @@ void vma_set_page_prot(struct vm_area_struct *vma)
 		vm_flags &= ~VM_SHARED;
 		vm_page_prot = vm_pgprot_modify(vm_page_prot, vm_flags);
 	}
+#ifdef CONFIG_KEMU
+	/*
+	 * Guest VMAs of a kemu process are never executed natively (only read
+	 * for translation), so drop host executability from them while keeping
+	 * VM_EXEC as the semantic flag. kemu's own region (translated code and
+	 * trampoline) is excluded and stays host-executable (DESIGN §6.1,
+	 * audit H-02).
+	 */
+	if ((vm_flags & VM_EXEC) && vma->vm_mm && vma->vm_mm->kemu_guest &&
+	    !kemu_vma_is_region(vma))
+		vm_page_prot = vm_pgprot_modify(vm_page_prot, vm_flags & ~VM_EXEC);
+#endif
 	/* remove_protection_ptes reads vma->vm_page_prot without mmap_lock */
 	WRITE_ONCE(vma->vm_page_prot, vm_page_prot);
 }

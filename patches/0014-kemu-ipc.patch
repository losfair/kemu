diff --git a/ipc/sem.c b/ipc/sem.c
index 0f06e4bd4..162da0158 100644
--- a/ipc/sem.c
+++ b/ipc/sem.c
@@ -89,6 +89,7 @@
 #include <linux/rhashtable.h>
 
 #include <linux/uaccess.h>
+#include <linux/kemu.h>
 #include "util.h"
 
 /* One semaphore structure for each semaphore in the system. */
@@ -1707,6 +1708,23 @@ SYSCALL_DEFINE4(semctl, int, semid, int, semnum, int, cmd, unsigned long, arg)
 	return ksys_semctl(semid, semnum, cmd, arg, IPC_64);
 }
 
+#ifdef CONFIG_KEMU
+/*
+ * kemu marshals semid64_ds itself (the x86_64 layout has two extra padding
+ * words the arm64/asm-generic layout lacks), so it needs the IPC_STAT and
+ * IPC_SET work on a kernel struct rather than a user buffer.
+ */
+int kemu_semctl_stat(int semid, int cmd, struct semid64_ds *out)
+{
+	return semctl_stat(current->nsproxy->ipc_ns, semid, cmd, out);
+}
+
+int kemu_semctl_set(int semid, int cmd, struct semid64_ds *in)
+{
+	return semctl_down(current->nsproxy->ipc_ns, semid, cmd, in);
+}
+#endif
+
 #ifdef CONFIG_ARCH_WANT_IPC_PARSE_VERSION
 long ksys_old_semctl(int semid, int semnum, int cmd, unsigned long arg)
 {

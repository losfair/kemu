diff --git a/arch/x86/entry/syscall_64.c b/arch/x86/entry/syscall_64.c
index b6e68ea98..e852b32d1 100644
--- a/arch/x86/entry/syscall_64.c
+++ b/arch/x86/entry/syscall_64.c
@@ -5,6 +5,7 @@
 #include <linux/sys.h>
 #include <linux/cache.h>
 #include <linux/syscalls.h>
+#include <linux/kemu.h>
 #include <linux/entry-common.h>
 #include <linux/nospec.h>
 #include <asm/syscall.h>
@@ -86,6 +87,10 @@ static __always_inline bool do_syscall_x32(struct pt_regs *regs, int nr)
 /* Returns true to return using SYSRET, or false to use IRET */
 __visible noinstr bool do_syscall_64(struct pt_regs *regs, int nr)
 {
+#ifdef CONFIG_KEMU
+	if (static_branch_unlikely(&kemu_active_key) && current->kemu)
+		return kemu_do_syscall(regs, nr);
+#endif
 	add_random_kstack_offset();
 	nr = syscall_enter_from_user_mode(regs, nr);
 
diff --git a/arch/x86/include/asm/entry-common.h b/arch/x86/include/asm/entry-common.h
index ce3eb6d5f..cf5217c4c 100644
--- a/arch/x86/include/asm/entry-common.h
+++ b/arch/x86/include/asm/entry-common.h
@@ -3,6 +3,7 @@
 #define _ASM_X86_ENTRY_COMMON_H
 
 #include <linux/randomize_kstack.h>
+#include <linux/kemu.h>
 #include <linux/user-return-notifier.h>
 
 #include <asm/nospec-branch.h>
@@ -65,6 +66,11 @@ static inline void arch_exit_to_user_mode_prepare(struct pt_regs *regs,
 	if (unlikely(ti_work))
 		arch_exit_work(ti_work);
 
+#ifdef CONFIG_KEMU
+	if (static_branch_unlikely(&kemu_active_key))
+		kemu_exit_to_user(regs);
+#endif
+
 	fred_update_rsp0();
 
 #ifdef CONFIG_COMPAT

# Merged on top of x86_64 defconfig + kvm_guest.config for CI builds.
CONFIG_RUST=y
CONFIG_KEMU=y
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y
CONFIG_BLK_DEV_INITRD=y
CONFIG_VIRTIO_PCI=y
CONFIG_VIRTIO_BLK=y
CONFIG_NET_9P=y
CONFIG_NET_9P_VIRTIO=y
CONFIG_9P_FS=y
CONFIG_9P_FS_POSIX_ACL=y
CONFIG_EXT4_FS=y
CONFIG_DEBUG_INFO_NONE=y
# Rust in 6.18 is incompatible with these
CONFIG_MODVERSIONS=n
CONFIG_DEBUG_INFO_BTF=n
